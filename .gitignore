# Встроенная среда выполнения: Python 3.14 embed + pandoc.exe (218 MB)
# НЕ является исходным кодом – разворачивается на рабочей машине
runtime/

# Артефакты тестов/QA/диагностики – генерируются локально прогонами
qa_artifacts/
test_exports/
data/

# Сторонние шаблоны дизайна (бинарные AI/EPS/FIG, 113 MB) – референс,
# не исходный код приложения
design_templates/

# Решение заказчика 17.11.2026: исторические промпты/отчеты сессий и
# вся тестовая/QA-обвязка остаются только локально, в репозиторий не
# вносятся
old prompts (done prompts)/
smoke_test.py
gesture_test.py
visual_qa_runner.py
run_qa.cmd
run_qa_pdf.cmd
run_qa_pdf.ps1
render_pdf_pages.ps1
run_app_debug.cmd

# Кэш Python
__pycache__/
*.py[codz]
*$py.class

# Временные диагностические файлы сессий
_tmp_*
*.tmp
*.tmp_*
*~

# Локальные/служебные
*.log
.idea/
.vscode/
Thumbs.db
Desktop.ini

# Переносимое хранилище настроек приложения (сессия 19, раунд замечаний):
# INI-файл живёт рядом с программой, потому что на рабочей машине не
# создавались ни ключи реестра, ни файл в %APPDATA%. Это данные
# пользователя, не исходный код.
settings/

# резервные копии шаблона
*.docx.bak
